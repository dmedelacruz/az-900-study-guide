---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionReadTracker from '../../components/SectionReadTracker.astro';

export async function getStaticPaths() {
  const sections = await getCollection('sections');
  return sections.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.section} ${entry.data.title} — AZ-900 Study Guide`} description={entry.data.description}>
  <h1 class="mb-4">{entry.data.section} {entry.data.title}</h1>
  <article class="prose prose-blue dark:prose-invert max-w-none">
    <Content />
  </article>
  <SectionReadTracker sectionId={entry.id} />
</BaseLayout>
