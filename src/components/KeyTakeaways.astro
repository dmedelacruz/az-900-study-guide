---
// src/components/KeyTakeaways.astro — Summary box for key points at the end of each section
---

<aside
  class="key-takeaways my-10 rounded-lg border-l-4 border-blue-500 dark:border-blue-400 bg-blue-50 dark:bg-blue-950/40 px-6 py-5"
  aria-label="Key Takeaways"
>
  <div class="flex items-center gap-2.5 mb-4">
    <!-- Lightbulb icon -->
    <svg
      class="w-5 h-5 flex-shrink-0 text-blue-600 dark:text-blue-400"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m1.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
      />
    </svg>
    <h3 class="text-sm font-semibold uppercase tracking-wider text-blue-700 dark:text-blue-300 m-0">
      Key Takeaways
    </h3>
  </div>

  <div class="key-takeaways-content text-gray-700 dark:text-gray-200 text-sm leading-relaxed [&>ul]:mt-0 [&>ul]:space-y-1.5 [&>ul>li]:leading-relaxed">
    <slot />
  </div>
</aside>
