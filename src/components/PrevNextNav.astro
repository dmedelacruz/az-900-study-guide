---
// src/components/PrevNextNav.astro — Previous/Next section navigation

import { allSections as sections } from '../data/navData';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Normalize path for comparison (strip trailing slash variations)
const normalize = (p: string) => p.replace(/\/$/, '');
const currentIndex = sections.findIndex(
  (s) => normalize(s.href) === normalize(currentPath)
);

const prev = currentIndex > 0 ? sections[currentIndex - 1] : null;
const next = currentIndex !== -1 && currentIndex < sections.length - 1 ? sections[currentIndex + 1] : null;

// Don't render if no prev/next (e.g. non-section page)
const shouldRender = prev !== null || next !== null;
---

{shouldRender && (
  <nav aria-label="Section navigation" class="mt-16 pt-6 border-t border-gray-200">
    <div class="flex items-stretch justify-between gap-4">
      <!-- Previous -->
      {prev ? (
        <a
          href={prev.href}
          class="group flex-1 max-w-xs flex flex-col gap-1 px-4 py-3 rounded-lg border border-gray-200 no-underline hover:border-blue-300 hover:bg-blue-50 transition-colors"
        >
          <span class="flex items-center gap-1 text-xs font-medium text-gray-400 group-hover:text-blue-500 transition-colors">
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Previous
          </span>
          <span class="text-sm font-medium text-blue-700 group-hover:text-blue-800 transition-colors leading-snug">
            {prev.title}
          </span>
        </a>
      ) : (
        <div class="flex-1 max-w-xs" />
      )}

      <!-- Next -->
      {next ? (
        <a
          href={next.href}
          class="group flex-1 max-w-xs flex flex-col gap-1 items-end text-right px-4 py-3 rounded-lg border border-gray-200 no-underline hover:border-blue-300 hover:bg-blue-50 transition-colors"
        >
          <span class="flex items-center gap-1 text-xs font-medium text-gray-400 group-hover:text-blue-500 transition-colors">
            Next
            <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </span>
          <span class="text-sm font-medium text-blue-700 group-hover:text-blue-800 transition-colors leading-snug">
            {next.title}
          </span>
        </a>
      ) : (
        <div class="flex-1 max-w-xs" />
      )}
    </div>
  </nav>
)}
