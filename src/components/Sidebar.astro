---
// src/components/Sidebar.astro — Collapsible sidebar navigation

import { navData } from '../data/navData';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const totalSections = navData.flatMap(g => g.sections).length;
---

<!-- Mobile hamburger button -->
<button
  id="sidebar-open-btn"
  type="button"
  class="fixed top-4 left-4 z-50 lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 shadow-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
  aria-label="Open navigation"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<!-- Backdrop (mobile only) -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-40 bg-black/40 transition-opacity duration-300 opacity-0 pointer-events-none lg:hidden"
></div>

<!-- Sidebar -->
<aside
  id="sidebar"
  class="sidebar-nav fixed top-0 left-0 z-40 h-screen w-64 bg-gray-50 dark:bg-gray-900 border-r border-gray-200 dark:border-gray-700 flex flex-col overflow-y-auto transition-transform duration-300 -translate-x-full lg:translate-x-0"
  data-current-path={currentPath}
  data-total-sections={totalSections}
>
  <!-- Header -->
  <div class="px-5 pt-5 pb-3 border-b border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between">
      <a href={import.meta.env.BASE_URL} class="text-lg font-semibold text-gray-900 dark:text-gray-100">AZ-900 Study Guide</a>
      <div class="flex items-center gap-1">
        <span
          id="sidebar-xp-counter"
          class="text-xs font-medium text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-950 px-1.5 py-0.5 rounded hidden"
          aria-label="Total XP earned"
        >0 XP</span>
        <ThemeToggle />
        <button
          id="sidebar-close-btn"
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-8 h-8 rounded-md text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
          aria-label="Close navigation"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
    <!-- Completion progress bar -->
    <div class="mt-3" id="sidebar-progress-container">
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs text-gray-500 dark:text-gray-400">Progress</span>
        <span
          id="sidebar-completion-pct"
          class="text-xs font-medium text-gray-600 dark:text-gray-300"
          aria-label="Overall completion percentage"
        >0%</span>
      </div>
      <div
        class="w-full h-1.5 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden"
        role="progressbar"
        aria-valuenow={0}
        aria-valuemin={0}
        aria-valuemax={100}
        aria-label="Study guide completion"
        id="sidebar-progress-bar-wrapper"
      >
        <div
          id="sidebar-progress-bar"
          class="h-full bg-blue-500 dark:bg-blue-400 rounded-full transition-all duration-300"
          style="width: 0%"
        ></div>
      </div>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-4 space-y-1">
    <a
      href={`${import.meta.env.BASE_URL}/dashboard/`}
      class:list={[
        'flex items-center gap-2 px-3 py-2 text-sm font-medium rounded mb-2 transition-colors',
        currentPath.endsWith('/dashboard/')
          ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400 border-l-2 border-blue-600 dark:border-blue-500 pl-2.5'
          : 'text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-800',
      ]}
      aria-current={currentPath.endsWith('/dashboard/') ? 'page' : undefined}
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
      Dashboard
    </a>
    {navData.map((group, idx) => (
      <div class="sidebar-group" data-expanded="true">
        <button
          type="button"
          class="sidebar-group-toggle flex items-center justify-between w-full px-2 py-2 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 rounded transition-colors"
          aria-expanded="true"
          aria-controls={`sidebar-group-${idx}`}
        >
          <span>{group.domain} <span class="text-gray-400 dark:text-gray-500 font-normal normal-case tracking-normal">({group.weight})</span></span>
          <svg class="sidebar-chevron w-4 h-4 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <ul id={`sidebar-group-${idx}`} class="sidebar-group-links mt-1 space-y-0.5 overflow-hidden transition-all duration-200">
          {group.sections.map((section) => {
            const isActive = currentPath === section.href || currentPath === section.href.replace(/\/$/, '');
            // Extract sectionId from href: strip base + /sections/ prefix and trailing /
            const sectionId = section.href.replace(/^.*\/sections\//, '').replace(/\/$/, '');
            return (
              <li>
                <a
                  href={section.href}
                  data-section-id={sectionId}
                  class:list={[
                    'flex items-center justify-between px-3 py-1.5 text-sm rounded transition-colors',
                    isActive
                      ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400 font-medium border-l-2 border-blue-600 dark:border-blue-500 pl-2.5'
                      : 'text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-800',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span class="section-link-title">{section.title}</span>
                  <span class="section-link-indicators flex items-center gap-1 ml-1 flex-shrink-0"></span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const openBtn = document.getElementById('sidebar-open-btn');
    const closeBtn = document.getElementById('sidebar-close-btn');

    if (!sidebar || !backdrop || !openBtn || !closeBtn) return;

    // Mobile open/close
    function openSidebar() {
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeSidebar() {
      sidebar.classList.add('-translate-x-full');
      sidebar.classList.remove('translate-x-0');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('opacity-100');
      document.body.style.overflow = '';
      openBtn.focus();
    }

    openBtn.addEventListener('click', openSidebar);
    closeBtn.addEventListener('click', closeSidebar);
    backdrop.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSidebar();
    });

    // -----------------------------------------------------------------------
    // Progress / XP / Badge indicators
    // -----------------------------------------------------------------------

    const TOTAL_SECTIONS = parseInt(sidebar.dataset.totalSections ?? '0', 10);
    // Create a reusable checkmark SVG template (cloned per section to avoid innerHTML)
    const checkSvgTemplate = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    checkSvgTemplate.setAttribute('class', 'w-3.5 h-3.5 text-green-500 dark:text-green-400 flex-shrink-0');
    checkSvgTemplate.setAttribute('fill', 'none');
    checkSvgTemplate.setAttribute('stroke', 'currentColor');
    checkSvgTemplate.setAttribute('viewBox', '0 0 24 24');
    checkSvgTemplate.setAttribute('aria-hidden', 'true');
    const checkPath = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    checkPath.setAttribute('stroke-linecap', 'round');
    checkPath.setAttribute('stroke-linejoin', 'round');
    checkPath.setAttribute('stroke-width', '2.5');
    checkPath.setAttribute('d', 'M5 13l4 4L19 7');
    checkSvgTemplate.appendChild(checkPath);

    const BADGE_COLORS: Record<string, string> = {
      bronze: '#CD7F32',
      silver: '#C0C0C0',
      gold: '#FFD700',
    };

    function getSectionsRead(): Set<string> {
      try {
        const raw = localStorage.getItem('az900-sections-read');
        if (raw) {
          const parsed = JSON.parse(raw);
          if (Array.isArray(parsed)) return new Set(parsed as string[]);
        }
      } catch { /* ignore */ }
      return new Set();
    }

    function getTotalXP(): number {
      try {
        const raw = localStorage.getItem('az900-xp-data');
        if (raw) {
          const parsed = JSON.parse(raw) as { entries?: { points: number }[] };
          if (parsed && Array.isArray(parsed.entries)) {
            return parsed.entries.reduce((acc: number, e: { points: number }) => acc + e.points, 0);
          }
        }
      } catch { /* ignore */ }
      return 0;
    }

    function getBadges(): Record<string, { tier: string }> {
      try {
        const raw = localStorage.getItem('az900-badge-data');
        if (raw) {
          const parsed = JSON.parse(raw) as { badges?: Record<string, { tier: string }> };
          if (parsed && typeof parsed.badges === 'object' && parsed.badges !== null) {
            return parsed.badges;
          }
        }
      } catch { /* ignore */ }
      return {};
    }

    function updateXPCounter(xp: number): void {
      const xpEl = document.getElementById('sidebar-xp-counter');
      if (!xpEl) return;
      xpEl.textContent = `${xp} XP`;
      if (xp > 0) {
        xpEl.classList.remove('hidden');
      } else {
        xpEl.classList.add('hidden');
      }
    }

    function updateCompletionBar(sectionsRead: Set<string>): void {
      const pct = TOTAL_SECTIONS > 0 ? Math.round((sectionsRead.size / TOTAL_SECTIONS) * 100) : 0;
      const pctEl = document.getElementById('sidebar-completion-pct');
      const barEl = document.getElementById('sidebar-progress-bar');
      const wrapperEl = document.getElementById('sidebar-progress-bar-wrapper');
      if (pctEl) pctEl.textContent = `${pct}%`;
      if (barEl) barEl.style.width = `${pct}%`;
      if (wrapperEl) wrapperEl.setAttribute('aria-valuenow', String(pct));
    }

    function getOrCreateIndicatorSpan(linkEl: Element): HTMLSpanElement {
      let span = linkEl.querySelector('.section-link-indicators') as HTMLSpanElement | null;
      if (!span) {
        span = document.createElement('span');
        span.className = 'section-link-indicators flex items-center gap-1 ml-1 flex-shrink-0';
        linkEl.appendChild(span);
      }
      return span;
    }

    function updateSectionIndicators(
      sectionsRead: Set<string>,
      badges: Record<string, { tier: string }>
    ): void {
      const links = document.querySelectorAll<HTMLAnchorElement>('a[data-section-id]');
      links.forEach((link) => {
        const sectionId = link.dataset.sectionId;
        if (!sectionId) return;

        const indicators = getOrCreateIndicatorSpan(link);

        // Remove existing dynamic indicators (checkmark + badge dot)
        indicators.querySelectorAll('.sidebar-checkmark, .sidebar-badge-dot').forEach((el) => el.remove());

        // Checkmark for read sections
        if (sectionsRead.has(sectionId)) {
          const check = document.createElement('span');
          check.className = 'sidebar-checkmark';
          check.setAttribute('aria-label', 'Section read');
          check.setAttribute('role', 'img');
          check.appendChild(checkSvgTemplate.cloneNode(true));
          indicators.appendChild(check);
        }

        // Badge dot for earned badges
        const badge = badges[sectionId];
        if (badge) {
          const dot = document.createElement('span');
          dot.className = 'sidebar-badge-dot w-2 h-2 rounded-full flex-shrink-0 inline-block';
          dot.style.backgroundColor = BADGE_COLORS[badge.tier] ?? '#C0C0C0';
          const tierLabel = badge.tier.charAt(0).toUpperCase() + badge.tier.slice(1);
          dot.setAttribute('aria-label', `${tierLabel} badge earned`);
          dot.setAttribute('role', 'img');
          dot.title = `${tierLabel} badge`;
          indicators.appendChild(dot);
        }
      });
    }

    function refreshSidebarIndicators(): void {
      const sectionsRead = getSectionsRead();
      const xp = getTotalXP();
      const badges = getBadges();
      updateXPCounter(xp);
      updateCompletionBar(sectionsRead);
      updateSectionIndicators(sectionsRead, badges);
    }

    // Initial render
    refreshSidebarIndicators();

    // Real-time updates via custom events
    for (const evt of ['progress:section-read', 'progress:section-unread', 'xp:earned', 'badge:earned']) {
      document.addEventListener(evt, refreshSidebarIndicators);
    }

    // Collapse/expand domain groups
    const groups = document.querySelectorAll('.sidebar-group');
    groups.forEach((group) => {
      const toggle = group.querySelector('.sidebar-group-toggle');
      const links = group.querySelector('.sidebar-group-links') as HTMLElement | null;
      const chevron = group.querySelector('.sidebar-chevron');
      if (!toggle || !links || !chevron) return;

      toggle.addEventListener('click', () => {
        const expanded = group.getAttribute('data-expanded') === 'true';
        if (expanded) {
          group.setAttribute('data-expanded', 'false');
          toggle.setAttribute('aria-expanded', 'false');
          links.style.maxHeight = links.scrollHeight + 'px';
          requestAnimationFrame(() => {
            links.style.maxHeight = '0px';
            links.style.opacity = '0';
          });
          chevron.classList.add('-rotate-90');
        } else {
          group.setAttribute('data-expanded', 'true');
          toggle.setAttribute('aria-expanded', 'true');
          links.style.maxHeight = links.scrollHeight + 'px';
          links.style.opacity = '1';
          links.addEventListener('transitionend', function handler() {
            links.style.maxHeight = 'none';
            links.removeEventListener('transitionend', handler);
          });
          chevron.classList.remove('-rotate-90');
        }
      });

      // Initialize expanded state — use 'none' so it adapts to content
      links.style.maxHeight = 'none';
      links.style.opacity = '1';
    });
  });
</script>
