---
// src/components/Sidebar.astro — Collapsible sidebar navigation

import { navData } from '../data/navData';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
---

<!-- Mobile hamburger button -->
<button
  id="sidebar-open-btn"
  type="button"
  class="fixed top-4 left-4 z-50 lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 shadow-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
  aria-label="Open navigation"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
  </svg>
</button>

<!-- Backdrop (mobile only) -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-40 bg-black/40 transition-opacity duration-300 opacity-0 pointer-events-none lg:hidden"
></div>

<!-- Sidebar -->
<aside
  id="sidebar"
  class="sidebar-nav fixed top-0 left-0 z-40 h-screen w-64 bg-gray-50 dark:bg-gray-900 border-r border-gray-200 dark:border-gray-700 flex flex-col overflow-y-auto transition-transform duration-300 -translate-x-full lg:translate-x-0"
  data-current-path={currentPath}
>
  <!-- Header -->
  <div class="flex items-center justify-between px-5 py-5 border-b border-gray-200 dark:border-gray-700">
    <a href="/" class="text-lg font-semibold text-gray-900 dark:text-gray-100">AZ-900 Study Guide</a>
    <div class="flex items-center gap-1">
      <ThemeToggle />
      <button
        id="sidebar-close-btn"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-8 h-8 rounded-md text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
        aria-label="Close navigation"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Navigation -->
  <nav class="flex-1 px-3 py-4 space-y-1">
    {navData.map((group, idx) => (
      <div class="sidebar-group" data-expanded="true">
        <button
          type="button"
          class="sidebar-group-toggle flex items-center justify-between w-full px-2 py-2 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 rounded transition-colors"
          aria-expanded="true"
          aria-controls={`sidebar-group-${idx}`}
        >
          <span>{group.domain} <span class="text-gray-400 dark:text-gray-500 font-normal normal-case tracking-normal">({group.weight})</span></span>
          <svg class="sidebar-chevron w-4 h-4 flex-shrink-0 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <ul id={`sidebar-group-${idx}`} class="sidebar-group-links mt-1 space-y-0.5 overflow-hidden transition-all duration-200">
          {group.sections.map((section) => {
            const isActive = currentPath === section.href || currentPath === section.href.replace(/\/$/, '');
            return (
              <li>
                <a
                  href={section.href}
                  class:list={[
                    'block px-3 py-1.5 text-sm rounded transition-colors',
                    isActive
                      ? 'bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-400 font-medium border-l-2 border-blue-600 dark:border-blue-500 pl-2.5'
                      : 'text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-gray-100 dark:hover:bg-gray-800',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {section.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const openBtn = document.getElementById('sidebar-open-btn');
    const closeBtn = document.getElementById('sidebar-close-btn');

    if (!sidebar || !backdrop || !openBtn || !closeBtn) return;

    // Mobile open/close
    function openSidebar() {
      sidebar.classList.remove('-translate-x-full');
      sidebar.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0', 'pointer-events-none');
      backdrop.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
      closeBtn.focus();
    }

    function closeSidebar() {
      sidebar.classList.add('-translate-x-full');
      sidebar.classList.remove('translate-x-0');
      backdrop.classList.add('opacity-0', 'pointer-events-none');
      backdrop.classList.remove('opacity-100');
      document.body.style.overflow = '';
      openBtn.focus();
    }

    openBtn.addEventListener('click', openSidebar);
    closeBtn.addEventListener('click', closeSidebar);
    backdrop.addEventListener('click', closeSidebar);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeSidebar();
    });

    // Collapse/expand domain groups
    const groups = document.querySelectorAll('.sidebar-group');
    groups.forEach((group) => {
      const toggle = group.querySelector('.sidebar-group-toggle');
      const links = group.querySelector('.sidebar-group-links') as HTMLElement | null;
      const chevron = group.querySelector('.sidebar-chevron');
      if (!toggle || !links || !chevron) return;

      toggle.addEventListener('click', () => {
        const expanded = group.getAttribute('data-expanded') === 'true';
        if (expanded) {
          group.setAttribute('data-expanded', 'false');
          toggle.setAttribute('aria-expanded', 'false');
          links.style.maxHeight = links.scrollHeight + 'px';
          requestAnimationFrame(() => {
            links.style.maxHeight = '0px';
            links.style.opacity = '0';
          });
          chevron.classList.add('-rotate-90');
        } else {
          group.setAttribute('data-expanded', 'true');
          toggle.setAttribute('aria-expanded', 'true');
          links.style.maxHeight = links.scrollHeight + 'px';
          links.style.opacity = '1';
          links.addEventListener('transitionend', function handler() {
            links.style.maxHeight = 'none';
            links.removeEventListener('transitionend', handler);
          });
          chevron.classList.remove('-rotate-90');
        }
      });

      // Initialize expanded state — use 'none' so it adapts to content
      links.style.maxHeight = 'none';
      links.style.opacity = '1';
    });
  });
</script>
