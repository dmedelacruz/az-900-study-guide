---
// src/components/Breadcrumb.astro — Breadcrumb trail for section pages

import { navData } from '../data/navData';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Only render on section pages
const isSectionPage = currentPath.includes('/sections/');
if (!isSectionPage) return;

// Normalize path for comparison (ensure trailing slash)
const normPath = currentPath.endsWith('/') ? currentPath : currentPath + '/';

let foundDomain: string | null = null;
let foundSection: string | null = null;

for (const group of navData) {
  for (const section of group.sections) {
    if (section.href === normPath || section.href === currentPath) {
      foundDomain = group.domain;
      foundSection = section.title;
      break;
    }
  }
  if (foundDomain) break;
}

// If no match found, don't render
if (!foundDomain || !foundSection) return;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="inline-flex flex-wrap items-baseline gap-x-1.5 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
    <li class="inline-flex items-baseline gap-1.5">
      <a href={import.meta.env.BASE_URL} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors whitespace-nowrap">Home</a>
      <svg aria-hidden="true" class="w-3 h-3 flex-shrink-0 text-gray-400 dark:text-gray-600 self-center" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </li>

    <li class="inline-flex items-baseline gap-1.5">
      <span class="text-gray-500 dark:text-gray-400">{foundDomain}</span>
      <svg aria-hidden="true" class="w-3 h-3 flex-shrink-0 text-gray-400 dark:text-gray-600 self-center" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </li>

    <li>
      <span class="text-gray-900 dark:text-gray-100 font-medium" aria-current="page">{foundSection}</span>
    </li>
  </ol>
</nav>
