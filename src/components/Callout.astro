---
// src/components/Callout.astro — Reusable callout box for info, warning, and tip messages in MDX content

interface Props {
  type: "info" | "warning" | "tip";
  title?: string;
}

const { type, title } = Astro.props;

const config = {
  info: {
    label: "Info",
    border: "border-blue-500 dark:border-blue-400",
    bg: "bg-blue-50 dark:bg-blue-950/40",
    iconColor: "text-blue-600 dark:text-blue-400",
    labelColor: "text-blue-700 dark:text-blue-300",
  },
  warning: {
    label: "Warning",
    border: "border-amber-500 dark:border-amber-400",
    bg: "bg-amber-50 dark:bg-amber-950/40",
    iconColor: "text-amber-600 dark:text-amber-400",
    labelColor: "text-amber-700 dark:text-amber-300",
  },
  tip: {
    label: "Tip",
    border: "border-green-500 dark:border-green-400",
    bg: "bg-green-50 dark:bg-green-950/40",
    iconColor: "text-green-600 dark:text-green-400",
    labelColor: "text-green-700 dark:text-green-300",
  },
};

const { label, border, bg, iconColor, labelColor } = config[type];
const displayLabel = title ?? label;
---

<aside
  class={`my-10 rounded-lg border-l-4 ${border} ${bg} px-6 py-5`}
  aria-label={displayLabel}
>
  <div class="flex items-center gap-2.5 mb-4">

    {/* Info circle icon */}
    {type === "info" && (
      <svg
        class={`w-5 h-5 flex-shrink-0 ${iconColor}`}
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
        />
      </svg>
    )}

    {/* Warning triangle icon */}
    {type === "warning" && (
      <svg
        class={`w-5 h-5 flex-shrink-0 ${iconColor}`}
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
        />
      </svg>
    )}

    {/* Lightbulb icon */}
    {type === "tip" && (
      <svg
        class={`w-5 h-5 flex-shrink-0 ${iconColor}`}
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m1.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
        />
      </svg>
    )}

    <h3 class={`text-sm font-semibold uppercase tracking-wider ${labelColor} m-0`}>
      {displayLabel}
    </h3>
  </div>

  <div class="text-gray-700 dark:text-gray-200 text-sm leading-relaxed [&>p]:mt-0 [&>ul]:mt-0 [&>ul]:space-y-1.5 [&>ul>li]:leading-relaxed">
    <slot />
  </div>
</aside>
